{
  "name": "chainpc-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ChainPC – Decentralized PC Marketplace smart contracts (Hardhat)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:hoodi": "hardhat run scripts/deploy.ts --network hoodi",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "seed:hoodi": "hardhat run scripts/seed.ts --network hoodi",
    "verify:hoodi": "hardhat run scripts/verify.ts --network hoodi",
    "export:web": "hardhat run scripts/export-web.ts",
    "import:hoodi": "hardhat run scripts/import-deployment.ts --network hoodi"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/node": "^22.20.5",
    "dotenv": "^16.6.1",
    "hardhat": "^2.29.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
